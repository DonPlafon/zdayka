# Required for signed sessions (generate a long random value)
SESSION_SECRET=
# Telegram bot credentials, configured in @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Telegram user IDs for staff access
OWNER_TELEGRAM_ID=
MANAGER_TELEGRAM_ID=
# Staff access to /admin. Generate each password hash with node scripts/generate-staff-password.mjs
STAFF_OWNER_LOGIN=
STAFF_OWNER_PASSWORD_HASH=
STAFF_MANAGER_LOGIN=
STAFF_MANAGER_PASSWORD_HASH=
# Public HTTPS origin once hosted, e.g. https://example.com
APP_ORIGIN=http://localhost:3000
# Keep closed until legal texts, payment method and Telegram have been reviewed.
PUBLIC_LAUNCH_ENABLED=0
# Optional public Telegram username for manager contact
MANAGER_USERNAME=
# Leave empty until a real payment method is approved
PAYMENT_INSTRUCTIONS=
# Local-only test identities. Never used in production.
DEV_TEST_LOGIN=0
# Optional secret for scheduled maintenance/notifications
CRON_SECRET=
NOTIFICATIONS_ENABLED=0
